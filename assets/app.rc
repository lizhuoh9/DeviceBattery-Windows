#define RT_MANIFEST 24

1 ICON "app.ico"
1 RT_MANIFEST "app.manifest"

// Version information shown in the file's Properties -> Details tab. rc.exe reads this script in
// the system code page, so keep it ASCII. A unit test (src/lib.rs) checks that the numbers and
// strings below match the version in Cargo.toml.
1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Zhuoheng Li"
            VALUE "FileDescription", "Device Battery"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "DeviceBattery"
            VALUE "LegalCopyright", "Copyright (C) 2026 Zhuoheng Li. MIT License."
            VALUE "OriginalFilename", "DeviceBattery.exe"
            VALUE "ProductName", "Device Battery"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
